# PerfumeShop.Api, server side only (the browser uses same-origin rewrites).
API_URL=http://localhost:5080
# Canonical shop URL for SEO (canonical links, sitemap, Open Graph).
SITE_URL=http://localhost:3000
# Shared with the API (Storefront:RevalidateSecret): lets Catalog changes rebuild cached pages. Secret, 32+ chars.
REVALIDATE_SECRET=
# Optional extra photo hosts (comma separated), e.g. the Cloudflare R2 public URL.
IMAGE_HOSTS=
